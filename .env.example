# Tạo khóa trong OpenAI API Platform rồi chép vào tệp .env.local
OPENAI_API_KEY=your_openai_api_key

# Có thể đổi model mà không sửa mã nguồn
AI_MODEL=gpt-5.6-luna

# Access gate: keep these values server-side; set them in Vercel Environment Variables before deployment.
APP_ACCESS_PASSWORD=replace_with_a_private_password
APP_ACCESS_SECRET=replace_with_a_long_random_secret
